{
  "name": "initx-plugin-git-report",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "description": "generate daily git commit reports for initx",
  "author": "imba97",
  "license": "MIT",
  "homepage": "https://github.com/imba97/initx-plugin-git-report#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:imba97/initx-plugin-git-report.git"
  },
  "bugs": {
    "url": "https://github.com/imba97/initx-plugin-git-report/issues"
  },
  "keywords": [
    "initx",
    "initx-plugin",
    "git",
    "report",
    "daily-report",
    "commit-log"
  ],
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "stub": "unbuild --stub",
    "build": "unbuild",
    "release": "bumpp",
    "lint": "eslint --cache",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "@initx-plugin/core": "*",
    "@initx-plugin/utils": "*"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@initx-plugin/core": "^0.3.3",
    "@initx-plugin/utils": "^0.3.3",
    "@types/node": "^25.5.0",
    "bumpp": "^11.0.1",
    "eslint": "^10.1.0",
    "nano-staged": "^0.9.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.2",
    "unbuild": "^3.6.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*": "eslint --cache --fix"
  }
}
